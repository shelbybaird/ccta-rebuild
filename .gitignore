# Build output. The published site is produced by the build, never committed.
/public/
/pub-root/
/pub-sub/
/verify-out/
/resources/_gen/
.hugo_build.lock

# macOS
.DS_Store

# Worker tooling. The deployed code is src/index.js; everything below is local
# scaffolding wrangler creates while building or running it.
/worker/node_modules/
/worker/.wrangler/

# Wrangler's own convention for secrets used while running the worker locally.
# Nothing has ever been written here, and this repository is public, so the
# rule exists before the file does rather than after.
/worker/.dev.vars
/worker/.dev.vars.*
/tools/__pycache__/
